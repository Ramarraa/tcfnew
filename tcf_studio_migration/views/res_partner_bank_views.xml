<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="res_partner_bank_form_studio_migration" model="ir.ui.view">
            <field name="name">res.partner.bank.form.migration</field>
            <field name="model">res.partner.bank</field>
            <field name="inherit_id" ref="account.view_res_partner_bank_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='acc_holder_name']" position="after">
                    <field name="iban_number"/>
                    <field name="branch_code"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
