<odoo>
    <!-- Standalone v16-parity body for the core "Picking Operations" report
         (stock.action_report_picking). Kept independent from any Studio-made
         duplicate (stock.report_picking_copy_1 and friends) so those stay
         untouched for their own separate use. Reuses web.external_layout,
         which already carries this module's Boxed-layout v16 parity fixes
         (header separator, no VAT line, footer page numbers). -->
    <template id="report_picking_v16">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page o_tcf_picking_v16">
                        <style t-translation="off">
                            .o_tcf_picking_v16 .o_tcf_header_row {
                                display: -webkit-box !important;
                                display: flex !important;
                                -webkit-box-orient: horizontal !important;
                                -webkit-box-pack: start !important;
                                flex-wrap: wrap !important;
                                margin-top: 48px !important;
                                margin-bottom: 32px !important;
                            }
                            .o_tcf_picking_v16 .o_tcf_header_row > div {
                                margin-right: 96px !important;
                            }
                            .o_tcf_picking_v16 .o_tcf_header_row > div strong,
                            .o_tcf_picking_v16 .o_tcf_header_row > div p {
                                display: block !important;
                                margin: 0 !important;
                            }
                            .o_tcf_picking_v16 table.o_tcf_picking_table {
                                width: 100%;
                                margin-top: 12px;
                                border-collapse: collapse;
                                color: #495057;
                            }
                            .o_tcf_picking_v16 table.o_tcf_picking_table th,
                            .o_tcf_picking_v16 table.o_tcf_picking_table td {
                                padding: 4px;
                                border: 1px solid #495057;
                                vertical-align: middle;
                            }
                            .o_tcf_picking_v16 table.o_tcf_picking_table thead th {
                                color: #af1015;
                                font-weight: 700;
                                text-align: center;
                                text-transform: uppercase;
                            }
                        </style>
                        <div class="row justify-content-end mb16">
                            <div class="col-4" name="right_box">
                                <img
                                    t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('Code128', o.name, 600, 100)"
                                    style="width:300px;height:50px;" alt="Barcode"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6" name="div_outgoing_address">
                                <div
                                    t-if="o.move_ids_without_package and o.move_ids_without_package[0].partner_id and o.move_ids_without_package[0].partner_id.id != o.partner_id.id">
                                    <span>
                                        <strong>Delivery Address:</strong>
                                    </span>
                                    <div t-field="o.move_ids_without_package[0].partner_id"
                                         t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
                                </div>
                                <div
                                    t-if="o.picking_type_id.code != 'internal' and (not o.move_ids_without_package or not o.move_ids_without_package[0].partner_id) and o.picking_type_id.warehouse_id.partner_id">
                                    <span>
                                        <strong>Warehouse Address:</strong>
                                    </span>
                                    <div t-field="o.picking_type_id.warehouse_id.partner_id"
                                         t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
                                </div>
                            </div>
                            <div class="col-5 offset-1" name="div_incoming_address">
                                <div t-if="o.picking_type_id.code=='incoming' and o.partner_id">
                                    <span>
                                        <strong>Vendor Address:</strong>
                                    </span>
                                </div>
                                <div t-if="o.picking_type_id.code=='internal' and o.partner_id">
                                    <span>
                                        <strong>Warehouse Address:</strong>
                                    </span>
                                </div>
                                <div t-if="o.picking_type_id.code=='outgoing' and o.partner_id">
                                    <span>
                                        <strong>Customer Address:</strong>
                                    </span>
                                </div>
                                <div t-if="o.partner_id" name="partner_header">
                                    <div t-field="o.partner_id"
                                         t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
                                    <p t-if="o.sudo().partner_id.vat"><t
                                        t-esc="o.company_id.country_id.vat_label or 'Tax ID'"/>:
                                        <span t-field="o.sudo().partner_id.vat"/>
                                    </p>
                                </div>
                            </div>
                        </div>
                        <br/>
                        <h1 t-field="o.name" class="mt0" style="color: #043665;"/>
                        <div class="o_tcf_header_row">
                            <div t-if="o.origin" name="div_origin">
                                <strong>Order:</strong>
                                <p t-field="o.origin"/>
                            </div>
                            <div name="div_state">
                                <strong>Status:</strong>
                                <p t-field="o.state"/>
                            </div>
                            <div name="div_sched_date">
                                <strong>Scheduled Date:</strong>
                                <p t-field="o.scheduled_date"/>
                            </div>
                        </div>
                        <table class="table table-sm o_tcf_picking_table" t-if="o.move_ids_without_package">
                            <t t-set="has_barcode"
                               t-value="any(move_line.product_id and move_line.product_id.sudo().barcode or move_line.package_id for move_line in o.move_line_ids)"/>
                            <t t-set="has_serial_number"
                               t-value="any(move_line.lot_id or move_line.lot_name for move_line in o.move_line_ids)"
                               groups="stock.group_production_lot"/>
                            <thead>
                                <tr>
                                    <th name="th_product">
                                        <strong>Product</strong>
                                    </th>
                                    <th>
                                        <strong>Quantity</strong>
                                    </th>
                                    <th name="th_from" t-if="o.picking_type_id.code != 'incoming'" align="left"
                                        groups="stock.group_stock_multi_locations">
                                        <strong>From</strong>
                                    </th>
                                    <th name="th_to" t-if="o.picking_type_id.code != 'outgoing'"
                                        groups="stock.group_stock_multi_locations">
                                        <strong>To</strong>
                                    </th>
                                    <th name="th_serial_number" class="text-center" t-if="has_serial_number">
                                        <strong>Lot/Serial Number</strong>
                                    </th>
                                    <th name="th_barcode" class="text-center" t-if="has_barcode">
                                        <strong>Product Barcode</strong>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.move_ids_without_package" t-as="move">
                                    <tr>
                                        <td>
                                            <span t-field="move.product_id.display_name"/>
                                            <br/>
                                            <span t-field="move.product_id.description_picking"/>
                                        </td>
                                        <td>
                                            <span t-field="move.product_uom_qty"/>
                                        </td>
                                        <td t-if="o.picking_type_id.code != 'incoming'"
                                            groups="stock.group_stock_multi_locations">
                                            <t t-foreach="move.move_line_ids.sorted(key=lambda ml: ml.location_id.id)"
                                               t-as="ml">
                                                <span t-esc="ml.location_id.display_name"/>
                                                <t t-if="ml.package_id">
                                                    <span t-field="ml.package_id"/>
                                                </t>
                                            </t>
                                        </td>
                                        <td t-if="o.picking_type_id.code != 'outgoing'"
                                            groups="stock.group_stock_multi_locations">
                                            <t t-foreach="move.move_line_ids.sorted(key=lambda ml: ml.location_id.id)"
                                               t-as="ml">
                                                <div>
                                                    <span t-field="ml.location_dest_id"/>
                                                    <t t-if="ml.result_package_id">
                                                        <span t-field="ml.result_package_id"/>
                                                    </t>
                                                </div>
                                            </t>
                                        </td>
                                        <td class="text-center h6" t-if="has_serial_number">
                                            <t t-foreach="move.move_line_ids.sorted(key=lambda ml: ml.location_id.id)"
                                               t-as="ml">
                                                <img t-if="has_serial_number and (ml.lot_id or ml.lot_name)"
                                                     t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s&amp;humanreadable=1' % ('Code128', ml.lot_id.name or ml.lot_name, 400, 100)"
                                                     style="width:100%;height:35px;" alt="Barcode"/>
                                            </t>
                                        </td>
                                        <td class="text-center" t-if="has_barcode">
                                            <t t-if="product_barcode != move.product_id.barcode">
                                                <span t-if="move.product_id and move.product_id.barcode">
                                                    <img t-if="len(move.product_id.barcode) == 13"
                                                         t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s&amp;quiet=%s' % ('EAN13', move.product_id.barcode, 400, 100, 0)"
                                                         style="height:35px" alt="Barcode"/>
                                                    <img t-elif="len(move.product_id.barcode) == 8"
                                                         t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s&amp;quiet=%s' % ('EAN8', move.product_id.barcode, 400, 100, 0)"
                                                         style="height:35px" alt="Barcode"/>
                                                    <img t-else=""
                                                         t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s&amp;quiet=%s' % ('Code128', move.product_id.barcode, 400, 100, 0)"
                                                         style="height:35px" alt="Barcode"/>
                                                </span>
                                                <t t-set="product_barcode" t-value="move.product_id.barcode"/>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <table class="table table-sm"
                               t-if="o.package_level_ids and o.picking_type_entire_packs and o.state in ['assigned', 'done']">
                            <thead>
                                <tr>
                                    <th name="th_package">Package</th>
                                    <th name="th_pko_from" t-if="o.picking_type_id.code != 'incoming'"
                                        groups="stock.group_stock_multi_locations">From
                                    </th>
                                    <th name="th_pki_from" t-if="o.picking_type_id.code != 'outgoing'"
                                        groups="stock.group_stock_multi_locations">To
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.package_level_ids.sorted(key=lambda p: p.package_id.name)"
                                    t-as="package">
                                    <t t-set="package" t-value="package.with_context(picking_id=o.id)"/>
                                    <td name="td_pk_barcode">
                                        <img
                                            t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s&amp;humanreadable=1' % ('Code128', package.package_id.name, 600, 100)"
                                            style="width:300px;height:50px; margin-left: -50px;" alt="Barcode"/>
                                        <br/>
                                    </td>
                                    <td t-if="o.picking_type_id.code != 'incoming'"
                                        groups="stock.group_stock_multi_locations">
                                        <span t-field="package.location_id"/>
                                    </td>
                                    <td t-if="o.picking_type_id.code != 'outgoing'"
                                        groups="stock.group_stock_multi_locations">
                                        <span t-field="package.location_dest_id"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <p t-field="o.note"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="stock.action_report_picking" model="ir.actions.report">
        <field name="report_name">tcf_studio_migration.report_picking_v16</field>
    </record>
</odoo>
