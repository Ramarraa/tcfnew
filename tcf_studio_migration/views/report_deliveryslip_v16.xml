<odoo>
    <!-- Standalone v16-parity body for the core "Delivery Slip" report
         (stock.action_report_delivery). Kept independent from any Studio-made
         duplicate (stock.report_deliveryslip_copy_1 and friends) so those
         stay untouched for their own separate use. Reuses web.external_layout,
         which already carries this module's Boxed-layout v16 parity fixes
         (header separator, no VAT line, footer page numbers). -->
    <template id="report_deliveryslip_v16">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page o_tcf_deliveryslip_v16">
                        <style t-translation="off">
                            .o_tcf_deliveryslip_v16 .o_tcf_header_row {
                                display: -webkit-box !important;
                                display: flex !important;
                                -webkit-box-orient: horizontal !important;
                                -webkit-box-pack: start !important;
                                flex-wrap: wrap !important;
                                margin-top: 24px !important;
                                margin-bottom: 24px !important;
                            }
                            .o_tcf_deliveryslip_v16 .o_tcf_header_row > div {
                                margin-right: 48px !important;
                            }
                            .o_tcf_deliveryslip_v16 .o_tcf_header_row > div strong,
                            .o_tcf_deliveryslip_v16 .o_tcf_header_row > div p {
                                display: block !important;
                                margin: 0 !important;
                            }
                            .o_tcf_deliveryslip_v16 table.o_tcf_delivery_table {
                                width: 100%;
                                margin-top: 12px;
                                border-collapse: collapse;
                                color: #495057;
                            }
                            .o_tcf_deliveryslip_v16 table.o_tcf_delivery_table th,
                            .o_tcf_deliveryslip_v16 table.o_tcf_delivery_table td {
                                padding: 4px;
                                border: 1px solid #495057;
                                vertical-align: middle;
                            }
                            .o_tcf_deliveryslip_v16 table.o_tcf_delivery_table thead th {
                                color: #af1015;
                                font-weight: 700;
                                text-align: center;
                                text-transform: uppercase;
                            }
                            .o_tcf_deliveryslip_v16 table.o_tcf_delivery_table td:nth-child(2) {
                                text-align: center;
                            }
                            .o_tcf_deliveryslip_v16 table.o_tcf_delivery_table tbody td:last-child {
                                background-color: #e9ecef;
                                color: #000;
                                font-weight: 700;
                                text-align: right;
                            }
                        </style>
                        <div class="row">
                            <div class="col-6" name="div_incoming_address">
                                <div t-if="o.picking_type_id.code=='incoming' and o.partner_id">
                                    <span>
                                        <strong>Vendor Address:</strong>
                                    </span>
                                </div>
                                <div t-if="o.picking_type_id.code=='internal' and o.partner_id">
                                    <span>
                                        <strong>Warehouse Address:</strong>
                                    </span>
                                </div>
                                <div t-if="o.picking_type_id.code=='outgoing' and o.partner_id">
                                    <span>
                                        <strong>Customer Address:</strong>
                                    </span>
                                </div>
                                <div t-if="o.partner_id" name="partner_header">
                                    <div t-field="o.partner_id"
                                         t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
                                </div>
                            </div>
                            <div class="col-6" name="div_outgoing_address">
                                <div
                                    t-if="o.picking_type_id.code != 'internal' and o.picking_type_id.warehouse_id.partner_id">
                                    <span>
                                        <strong>Warehouse Address:</strong>
                                    </span>
                                    <div t-field="o.picking_type_id.warehouse_id.partner_id"
                                         t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
                                </div>
                            </div>
                        </div>
                        <h2>
                            <span t-field="o.name"/>
                        </h2>
                        <div class="o_tcf_header_row">
                            <div t-if="o.origin" name="div_origin">
                                <strong>Order:</strong>
                                <p t-field="o.origin"/>
                            </div>
                            <div t-if="o.state" name="div_sched_date">
                                <strong>Shipping Date:</strong>
                                <p t-if="o.state == 'done'" t-field="o.date_done"/>
                                <p t-else="" t-field="o.scheduled_date"/>
                            </div>
                        </div>
                        <table class="table table-sm o_tcf_delivery_table" t-if="o.move_line_ids">
                            <thead>
                                <tr>
                                    <th name="th_product">
                                        <strong>Product</strong>
                                    </th>
                                    <th name="th_lot">
                                        <strong>Lot/Serial Number</strong>
                                    </th>
                                    <th name="th_delivered">
                                        <strong>Delivered</strong>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.move_line_ids" t-as="move_line">
                                    <td>
                                        <span t-field="move_line.product_id.display_name"/>
                                        <br/>
                                        <span t-field="move_line.product_id.display_name"/>
                                    </td>
                                    <td>
                                        <span t-esc="move_line.lot_id.name or move_line.lot_name or ''"/>
                                    </td>
                                    <td>
                                        <span t-field="move_line.quantity"/>
                                        <span t-field="move_line.product_uom_id" groups="uom.group_uom"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <p t-field="o.note"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="stock.action_report_delivery" model="ir.actions.report">
        <field name="report_name">tcf_studio_migration.report_deliveryslip_v16</field>
    </record>
</odoo>
