<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="fragrance_uses_view_form" model="ir.ui.view">
            <field name="name">fragrance.uses.form</field>
            <field name="model">fragrance.uses</field>
            <field name="arch" type="xml">
                <form string="Fragrance Use">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_products" type="object"
                                    class="oe_stat_button" icon="fa-cubes"
                                    invisible="product_count == 0">
                                <field name="product_count" widget="statinfo" string="Products"/>
                            </button>
                        </div>
                        <group>
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="fragrance_uses_view_list" model="ir.ui.view">
            <field name="name">fragrance.uses.list</field>
            <field name="model">fragrance.uses</field>
            <field name="arch" type="xml">
                <list string="Fragrance Uses">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="fragrance_uses_view_search" model="ir.ui.view">
            <field name="name">fragrance.uses.search</field>
            <field name="model">fragrance.uses</field>
            <field name="arch" type="xml">
                <search string="Fragrance Uses">
                    <field name="name"/>
                </search>
            </field>
        </record>

        <record id="action_fragrance_uses" model="ir.actions.act_window">
            <field name="name">Fragrance Uses</field>
            <field name="res_model">fragrance.uses</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_product_template_from_fragrance_use" model="ir.actions.act_window">
            <field name="name">Products</field>
            <field name="res_model">product.template</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('fragrance_use_id', '=', active_id)]</field>
        </record>

    </data>
</odoo>
