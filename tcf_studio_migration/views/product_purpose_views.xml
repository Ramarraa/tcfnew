<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="product_purpose_view_form" model="ir.ui.view">
            <field name="name">product.purpose.form</field>
            <field name="model">product.purpose</field>
            <field name="arch" type="xml">
                <form string="Product Purpose">
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <field name="active" invisible="1"/>
                        <field name="image_128" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" placeholder="Purpose Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="category_id"/>
                                <field name="color" widget="color_picker"/>
                                <field name="sequence"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Notes" name="notes">
                                <field name="notes"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="product_purpose_view_list" model="ir.ui.view">
            <field name="name">product.purpose.list</field>
            <field name="model">product.purpose</field>
            <field name="arch" type="xml">
                <list string="Product Purposes">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="category_id"/>
                    <field name="color" widget="color_picker"/>
                </list>
            </field>
        </record>

        <record id="product_purpose_view_search" model="ir.ui.view">
            <field name="name">product.purpose.search</field>
            <field name="model">product.purpose</field>
            <field name="arch" type="xml">
                <search string="Product Purposes">
                    <field name="name"/>
                    <field name="category_id"/>
                    <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                    <group>
                        <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_product_purpose" model="ir.actions.act_window">
            <field name="name">Product Purposes</field>
            <field name="res_model">product.purpose</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
