<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="brand_brand_view_form" model="ir.ui.view">
            <field name="name">brand.brand.form</field>
            <field name="model">brand.brand</field>
            <field name="arch" type="xml">
                <form string="Brand">
                    <header>
                        <field name="pipeline_status" widget="statusbar" options="{'clickable': '1'}"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_perfume_ids" type="object"
                                    class="oe_stat_button" icon="fa-flask"
                                    invisible="perfume_count == 0">
                                <field name="perfume_count" widget="statinfo" string="Perfumes"/>
                            </button>
                        </div>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <field name="active" invisible="1"/>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" placeholder="Brand Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="sequence"/>
                            </group>
                            <group>
                                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Notes" name="notes">
                                <field name="notes"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="brand_brand_view_list" model="ir.ui.view">
            <field name="name">brand.brand.list</field>
            <field name="model">brand.brand</field>
            <field name="arch" type="xml">
                <list string="Brands">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    <field name="pipeline_status"/>
                    <field name="code"/>
                </list>
            </field>
        </record>

        <record id="brand_brand_view_search" model="ir.ui.view">
            <field name="name">brand.brand.search</field>
            <field name="model">brand.brand</field>
            <field name="arch" type="xml">
                <search string="Brands">
                    <field name="name"/>
                    <field name="tag_ids"/>
                    <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                    <group>
                        <filter string="Pipeline Status" name="group_pipeline_status" context="{'group_by': 'pipeline_status'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_brand_brand" model="ir.actions.act_window">
            <field name="name">Brands</field>
            <field name="res_model">brand.brand</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_active': 1}</field>
        </record>

    </data>
</odoo>
