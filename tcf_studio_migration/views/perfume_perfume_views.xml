<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="perfume_perfume_view_form" model="ir.ui.view">
            <field name="name">perfume.perfume.form</field>
            <field name="model">perfume.perfume</field>
            <field name="arch" type="xml">
                <form string="Perfume">
                    <header>
                        <field name="status" widget="statusbar"/>
                        <field name="priority" widget="priority"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <field name="active" invisible="1"/>
                        <field name="avatar_image" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" placeholder="Perfume Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="matching_products_count" readonly="1"/>
                                <field name="brand_id"/>
                                <field name="sequence"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Notes" name="notes">
                                <field name="notes"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="perfume_perfume_view_list" model="ir.ui.view">
            <field name="name">perfume.perfume.list</field>
            <field name="model">perfume.perfume</field>
            <field name="arch" type="xml">
                <list string="Perfumes">
                    <field name="status" column_invisible="1"/>
                    <field name="name"/>
                    <field name="brand_id"/>
                    <field name="priority" widget="priority"/>
                    <field name="code"/>
                    <field name="matching_products_count" optional="show"/>
                    <field name="sequence"/>
                </list>
            </field>
        </record>

        <record id="perfume_perfume_view_search" model="ir.ui.view">
            <field name="name">perfume.perfume.search</field>
            <field name="model">perfume.perfume</field>
            <field name="arch" type="xml">
                <search string="Perfumes">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="brand_id"/>
                    <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                    <group>
                        <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                        <filter string="Brand" name="group_brand" context="{'group_by': 'brand_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_perfume_perfume" model="ir.actions.act_window">
            <field name="name">Perfumes</field>
            <field name="res_model">perfume.perfume</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_active': 1}</field>
        </record>

    </data>
</odoo>
