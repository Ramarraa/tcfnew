<odoo>
    <record id="view_sales_codes_stock_picking_form" model="ir.ui.view">
        <field name="name">view.sales.codes.stock.picking.form</field>
        <field name="active" eval="True"/>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids']/list/field[@name='product_id']" position="before">
                <field name="special_code"/>
            </xpath>
        </field>
    </record>
</odoo>
