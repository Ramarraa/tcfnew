<odoo>
    <record id="view_sale_order_advance_form" model="ir.ui.view">
        <field name="name">view.sale.order.advance.form</field>
        <field name="active" eval="True"/>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//list/field[@name='product_id']" position="after">
                <field name="special_code" force_save="1" />
                <field name="special_name" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
